# ===========================================
# Variables de Entorno - Gestión de Tickets
# Copiar a .env y ajustar según el entorno
# ===========================================

# Entorno: development | staging | production
NODE_ENV=development

# Base de Datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=ticketuser
DB_PASSWORD=ticketpass
DB_NAME=ticketdb

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redispass

# Seguridad JWT
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRES_IN=24h

# Backend
PORT=3000
LOG_LEVEL=debug
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Monitoreo
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Despliegue
DOCKER_REGISTRY=ghcr.io/zumberr
IMAGE_TAG=latest
